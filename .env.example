# ==============================================================================
# SSMO Institute of Teacher Education - Environment Configuration
# ==============================================================================
# Backend Architecture: Supabase (PostgreSQL + Auth + Storage)
# Deployment: Vercel
# Free-Tier Cost: ₹0 / month
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Configuration
# ------------------------------------------------------------------------------
# Find your Supabase Project URL in Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (for public client reads)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (secret key for administrative and write operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Storage Bucket Name (default: ssmo-assets)
SUPABASE_BUCKET_NAME=ssmo-assets

# ------------------------------------------------------------------------------
# 2. Admin Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing Admin JWT tokens (Generate a random 32+ char string)
ADMIN_JWT_SECRET=your_super_secret_jwt_encryption_key_2026

# Initial Default Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ssmo@admin2026

# ------------------------------------------------------------------------------
# 3. Application Configuration
# ------------------------------------------------------------------------------
# Base API URL (defaults to /api for same-origin Vercel deployment)
VITE_API_URL=/api
